// 供应商注册表 + 本地凭据存储 + 查询分发。
// 凭据 MVP 阶段存 uni storage（JSON 明文）；二期迁移到各端安全存储
// （iOS Keychain / Android Keystore / 鸿蒙 HUKS），见 README 路线图。
//
// 供应商分两类：
// - 内置（kind 直接对应供应商）：端点由 defaultUrlForKind 按官方地址拼接；
// - 自定义（kind == "custom"）：用户填完整端点 URL + 自选「协议模板」（protocol），
//   复用内置供应商的解析器——适配自建中转站 / 第三方镜像等场景。

import { StoredProvider, QuotaResult } from '../utils/types'
import { t } from '../utils/i18n'
import { vaultWrite, vaultRead, vaultDelete } from '../utils/vault'
import { fetchKimi } from './quota/kimi'
import { fetchZhipu, fetchZhipuTeam, zhipuQuotaBase } from './quota/zhipu'
import { fetchMinimax, minimaxDomain } from './quota/minimax'
import { fetchZenmux } from './quota/zenmux'
import { fetchOpencodeGo } from './quota/opencode_go'
import { fetchCustomJson } from './quota/custom_json'
import { fetchVolcengine } from './quota/volcengine'
import { fetchDeepseek } from './quota/deepseek'
import { fetchCodex } from './quota/codex'
import { fetchCodexFeelol } from './quota/codex_feelol'
import { fetchChatgptPlus } from './quota/chatgpt_plus'
import { fetchMimo } from './quota/mimo'
import { fetchClaude } from './quota/claude'
import { fetchGemini } from './quota/gemini'
import { makeFail } from './quota/shared'

/** 供应商类型元信息（驱动编辑页表单与首页标签；文案经 i18n key 取值） */
export type ProviderKindMeta = {
	kind : string
	labelKey : string
	needsBaseUrl : boolean     // true = 表单展示 Base URL 输入框
	baseUrlHint : string       // 输入框提示文案（技术示例，不本地化）
	baseUrlOptional : boolean  // true = 可留空走默认
	needsTeamFields : boolean  // zhipu_team 的组织/项目 ID
	needsAkSk : boolean        // volcengine：需要 AccessKey ID / Secret
	needsSessionJson : boolean // chatgpt_plus：粘贴 session JSON
	needsMimoFields : boolean  // mimo：双模式（后端 URL+Token 或 Cookie）
	needsProtocol : boolean    // custom：需要选择解析协议模板
	noteKey : string           // 表单下方说明（i18n key）
}

