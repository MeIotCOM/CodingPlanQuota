	"bal.grantedIncl" : " (incl. granted "
}

function loadPref() : string {
	const raw = uni.getStorageSync(PREF_KEY)
	if (raw == null) return LANG_AUTO
	if (typeof raw != "string") return LANG_AUTO
	const s = raw as string
	if (s.length == 0) return LANG_AUTO
	return s
}

function detectSystemLang() : string {
	try {
		const info = uni.getSystemInfoSync()
		const lang = info.language
		if (lang != null && (lang as string).length > 0) {
			const l = (lang as string).toLowerCase()
			if (l.startsWith("zh")) return LANG_ZH
			if (l.startsWith("de")) return LANG_DE
			if (l.startsWith("fr")) return LANG_FR
			if (l.startsWith("ja")) return LANG_JA
			if (l.startsWith("ko")) return LANG_KO
			if (l.startsWith("ru")) return LANG_RU
			if (l.startsWith("en")) return LANG_EN
			// 其他语言：国际用户回落英文
			return LANG_EN
		}
	} catch (e) {
		// 检测失败回落中文
	}
	return LANG_ZH
}

/** 按语言取字符串表 */
function tableFor(lang : string) : UTSJSONObject {
	if (lang == LANG_EN) return enTable
	if (lang == LANG_DE) return deTable
	if (lang == LANG_FR) return frTable
	if (lang == LANG_JA) return jaTable
	if (lang == LANG_KO) return koTable
	if (lang == LANG_RU) return ruTable
	return zhTable
}

function resolveLocale(pref : string) : string {
	if (pref == LANG_ZH) return LANG_ZH
	if (pref == LANG_EN) return LANG_EN
	if (pref == LANG_DE) return LANG_DE
	if (pref == LANG_FR) return LANG_FR
	if (pref == LANG_JA) return LANG_JA
	if (pref == LANG_KO) return LANG_KO
	if (pref == LANG_RU) return LANG_RU
	return detectSystemLang() // 仅 LANG_AUTO 走系统检测
}

/** 当前生效语言（首次访问时解析并缓存） */
export function getLang() : string {
	if (cachedLocale == "") {
		cachedLocale = resolveLocale(loadPref())
	}
	return cachedLocale
}

/** 语言偏好：auto / zh-Hans / en-US（切换后需重载页面生效） */
export function setLangPref(pref : string) {
	uni.setStorageSync(PREF_KEY, pref)
	cachedLocale = resolveLocale(pref)
}

export function getLangPref() : string {
	return loadPref()
}

/** 取字符串：当前语言 → 英文 → 中文 → 键名 */
export function t(key : string) : string {
	const lang = getLang()
	if (lang != LANG_ZH) {
		const v = tableFor(lang).getString(key)
		if (v != null) return v
		const e = enTable.getString(key)
		if (e != null) return e
	}
	const z = zhTable.getString(key)
	if (z != null) return z
	return key
}
