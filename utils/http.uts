// HTTP 封装：只提供额度查询需要的 GET + JSON 解析。
// 错误约定（对齐 docs/provider-api-spec.md 1.3）：
//   网络层失败（超时/断连）→ reject（瞬时，UI 可重试）；
//   拿到响应后的状态码/业务错误由各供应商模块自行判定。

export type HttpResponse = {
	statusCode : number
	json : UTSJSONObject | null
	text : string // 响应体不是 JSON 时的原始文本（拼错误信息用）
}

export function getJson(url : string, header : UTSJSONObject) : Promise<HttpResponse> {
	return new Promise<HttpResponse>((resolve, reject) => {
		uni.request({
			url : url,
			method : "GET",
			header : header,
			timeout : 15000,
			success : (res) => {
				let json : UTSJSONObject | null = null
				let text = ""
				const data = res.data
				if (typeof data == "string") {
					const s = data as string
					const parsed = JSON.parse<UTSJSONObject>(s)
					if (parsed != null) {
						json = parsed
					} else {
						text = s
					}
				} else if (data != null) {
					json = data as UTSJSONObject
				}
				const out : HttpResponse = { statusCode : res.statusCode, json : json, text : text }
				resolve(out)
			},
			fail : (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}

/** POST 空请求体（火山控制面 OpenAPI 用；header 需自带完整签名四件套） */
export function postEmpty(url : string, header : UTSJSONObject) : Promise<HttpResponse> {
	return new Promise<HttpResponse>((resolve, reject) => {
		uni.request({
			url : url,
			method : "POST",
			header : header,
			timeout : 15000,
			success : (res) => {
				let json : UTSJSONObject | null = null
				let text = ""
				const data = res.data
				if (typeof data == "string") {
					const s = data as string
					const parsed = JSON.parse<UTSJSONObject>(s)
					if (parsed != null) {
						json = parsed
					} else {
						text = s
					}
				} else if (data != null) {
					json = data as UTSJSONObject
				}
				const out : HttpResponse = { statusCode : res.statusCode, json : json, text : text }
				resolve(out)
			},
			fail : (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}
